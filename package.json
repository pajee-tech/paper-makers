{
  "name": "paper-maker-pk",
  "version": "1.0.0",
  "private": true,
  "description": "PaperMaker PK by Pajee Technologies \u2014 exam paper generator, textbook library & instant result maker for Pakistani institutions (Playgroup to BS).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "2.4.3",
    "katex": "0.16.11",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "nodemailer": "6.9.16",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/katex": "0.16.7",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "@types/nodemailer": "6.4.17"
  },
