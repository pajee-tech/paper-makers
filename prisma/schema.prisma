// Prisma schema — Neon PostgreSQL Free Tier
// If you already have a schema.prisma, keep yours; the app relies only on the
// model / field names below (they follow the spec). Diff and merge any extras.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE_TRIAL
  PAPER_MAKER_PRO
}

enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  TEACHER
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  ACADEMY
  DEGREE_INSTITUTE
}

enum AcademicLevel {
  EARLY_YEARS // Nursery, KG, Prep
  PRIMARY // 1st – 5th
  MIDDLE // 6th – 8th
  MATRIC // 9th – 10th
  INTERMEDIATE // 11th – 12th
  GRADUATION // BA, BSc, ADP, BS
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  MATCH_COLUMNS
  MISSING_LETTERS
  DICTATION
  TRACING
  PICTURE // identify/colour the built-in SVG icon
  SHORT
  LONG
  NUMERICAL
  TRANSLATION
  CASE_STUDY
  CODE
}

enum PaperType {
  WEEKLY
  MONTHLY
  MID_TERM
  SEND_UP
  ANNUAL
  SEMESTER
}

enum ResultStatus {
  DRAFT
  FINAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Institution {
  id            String          @id @default(cuid())
  name          String
  type          InstitutionType @default(SCHOOL)
  city          String?
  phone         String?
  address       String?
  logoDataUrl   String?         @db.Text
  plan          Plan            @default(FREE_TRIAL)
  proUntil      DateTime?
  papersCreated Int             @default(0) // lifetime counter used for the free-trial limit
  createdAt     DateTime        @default(now())

  users          User[]
  classes        AcademicClass[]
  papers         SavedPaper[]
  payments       PaymentRequest[]
  resultSessions PaperResultSession[]
  books          Book[]
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          Role         @default(TEACHER)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  papers      SavedPaper[]
  resetTokens PasswordResetToken[]

  @@index([institutionId])
}

model AcademicClass {
  id            String        @id @default(cuid())
  name          String // e.g. "Nursery", "Class 5", "9th", "1st Year", "BS Semester 3"
  level         AcademicLevel
  sortOrder     Int           @default(0)
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  subjects Subject[]
  papers   SavedPaper[]

  @@unique([institutionId, name])

  @@index([institutionId, sortOrder])
}

model Subject {
  id        String        @id @default(cuid())
  name      String
  isUrdu    Boolean       @default(false) // RTL subject (Urdu, Islamiat in Urdu, etc.)
  classId   String
  class     AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  chapters Chapter[]
  papers   SavedPaper[]

  @@unique([classId, name])
}

model Chapter {
  id        String  @id @default(cuid())
  number    Int     @default(1)
  title     String
  isAlp     Boolean @default(false) // part of Smart Syllabus / ALP
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  questions Question[]

  @@index([subjectId, number])
}

model Question {
  id            String       @id @default(cuid())
  type          QuestionType
  text          String       @db.Text // supports $KaTeX$ inline and $$block$$ math, ``` code ```
  urduText      String?      @db.Text // RTL text rendered with Noto Nastaliq Urdu
  options       Json? // MCQ: ["opt A","opt B","opt C","opt D"]
  correctOption Int? // MCQ: 0-based index
  answer        String?      @db.Text // TF / blank / short answer for the key
  matchPairs    Json? // [{ "left": "Cat", "right": "Meow" }]
  imageSnippet  String?      @db.Text // compressed WebP data URL cropped in-browser
  icon          String? // built-in SVG icon key (EARLY_YEARS / PRIMARY)
  needsLines    Boolean      @default(false) // printable 4-line / square tracing lines
  lineStyle     String? // "FOUR_LINE" | "SQUARE" | "PLAIN"
  lineCount     Int          @default(2)
  marks         Float        @default(1)
  difficulty    Int          @default(2) // 1 easy, 2 medium, 3 hard
  chapterId     String
  chapter       Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([chapterId, type]) // class → subject → chapter lookups use Subject(classId) + Chapter(subjectId) indexes
}

model SavedPaper {
  id            String      @id @default(cuid())
  title         String
  paperType     PaperType
  examDate      DateTime?
  timeAllowed   String? // "2:30 Hours"
  totalMarks    Float
  // Snapshot of sections + questions so later bank edits never change a printed paper.
  // [{ id, title, instructions, attemptAny, isObjective, questions:[QuestionSnapshot] }]
  sections      Json
  // Last used print settings: { size, orientation, columns, fontSize, showKey, showOmr }
  printSettings Json?
  // Builder choices restored on Edit: { scope, alpOnly, marksMode, useBank, useBook, bookId, bookChapterIds, chapterIds, withGenerated }
  buildOptions  Json?
  watermark     Boolean     @default(false) // true when created during FREE_TRIAL
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classId       String?
  class         AcademicClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId     String?
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  resultSessions PaperResultSession[]

  @@index([institutionId, createdAt])

  @@index([classId])

  @@index([subjectId])
}

model PaperResultSession {
  id            String       @id @default(cuid())
  paperId       String
  paper         SavedPaper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  totalMarks    Float
  passPercent   Float        @default(33)
  // [{ "grade": "A+", "min": 80 }, ...] highest first
  gradingScheme Json?
  status        ResultStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  scores StudentPaperScore[]

  @@index([paperId, createdAt])

  @@index([institutionId])
}

model StudentPaperScore {
  id            String             @id @default(cuid())
  sessionId     String
  session       PaperResultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rollNo        String
  studentName   String
  fatherName    String?
  parentPhone   String?
  mcqObtained   Float?
  subjectiveObtained Float?
  obtained      Float
  absent        Boolean            @default(false)
  percentage    Float              @default(0)
  grade         String?
  passed        Boolean            @default(false)
  position      Int?
  breakdown     Json? // per-question marks / OMR answers detected
  source        String? // "MANUAL" | "EXCEL" | "PDF_OMR"

  @@index([sessionId])
}

model PaymentRequest {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  method        String // JAZZCASH | EASYPAISA | BANK
  transactionId String
  amount        Float
  months        Int           @default(1)
  planKey       String?
  payerName     String?
  payerPhone    String?
  status        PaymentStatus @default(PENDING)
  note          String?
  createdAt     DateTime      @default(now())
  reviewedAt    DateTime?

  @@unique([method, transactionId])

  @@index([institutionId, status])
}

// ---------------------------------------------------------------------------
// Platform settings (single row, edited by Super Admin): trial/pro rules,
// prices, payment accounts, feature gates.
// ---------------------------------------------------------------------------
model PlatformSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Book / Syllabus library — textbook PDFs stored page-by-page as text
// (the PDF itself never leaves the browser, so no file storage cost).
// institutionId = null → platform library (uploaded by Super Admin, shared with everyone)
// ---------------------------------------------------------------------------
enum BookStatus {
  PROCESSING
  READY
}

model Book {
  id            String        @id @default(cuid())
  title         String
  board         String? // "Punjab (PCTB)", "Federal (NBF)", "Oxford", ...
  edition       String?
  level         AcademicLevel
  className     String // "Class 5", "9th", "1st Year (11th)"
  subjectName   String
  language      String        @default("en") // en | ur
  pageCount     Int           @default(0)
  pageOffset    Int           @default(0) // printed page no. = PDF page − offset
  status        BookStatus    @default(PROCESSING)
  institutionId String?
  institution   Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  pages    BookPage[]
  chapters BookChapter[]
  items    BookItem[]

  @@index([subjectName, level])

  @@index([institutionId])
}

model BookPage {
  id        String       @id @default(cuid())
  bookId    String
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNo    Int // PDF page number (1-based)
  text      String       @db.Text
  ocr       Boolean      @default(false)
  chapterId String?
  chapter   BookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@unique([bookId, pageNo])

  @@index([chapterId])
}

model BookChapter {
  id        String  @id @default(cuid())
  bookId    String
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  startPage Int
  endPage   Int
  topics    Json? // ["1.1 Sets", "1.2 Operations on sets"]
  isAlp     Boolean @default(false) // part of Smart Syllabus / ALP

  exercises BookExercise[]
  pages     BookPage[]
  items     BookItem[]

  @@index([bookId, number])
}

model BookExercise {
  id        String      @id @default(cuid())
  chapterId String
  chapter   BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String // "Exercise 1.2", "Review Questions"
  startPage Int
  endPage   Int

  items BookItem[]

  @@index([chapterId])
}

model BookItem {
  id            String        @id @default(cuid())
  bookId        String
  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       BookChapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  exerciseId    String?
  exercise      BookExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  pageNo        Int?
  qNo           String? // question number inside the exercise: "3", "iv", "3(b)"
  topic         String?
  source        String        @default("EXERCISE") // EXERCISE | GENERATED | MANUAL
  type          QuestionType
  text          String        @db.Text
  urduText      String?       @db.Text
  options       Json?
  correctOption Int?
  answer        String?       @db.Text
  matchPairs    Json?
  imageSnippet  String?       @db.Text
  marks         Float         @default(1)
  createdAt     DateTime      @default(now())

  @@index([bookId, chapterId])

  @@index([exerciseId])
}
