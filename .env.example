# --- Neon PostgreSQL (Free Tier) ---
# Pooled connection (host contains "-pooler") for the app on Vercel:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=1&pool_timeout=20"
# Direct (non-pooled) connection for prisma migrate / db push:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Super Admin (developer only) ---
# Normal sign-up never creates a Super Admin. The developer opens /developer (not linked anywhere),
# enters this key + this email, and the Super Admin account is created (or an existing account upgraded).
# Generate a key with: openssl rand -base64 24   — remove SUPER_ADMIN_SETUP_KEY after setup to disable /developer.
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_SETUP_KEY=""

# --- First-run defaults only: after launch, change prices, trial rules and payment
#     accounts from /admin → "Trial & Pro settings" (no redeploy needed) ---
NEXT_PUBLIC_APP_NAME="PaperMaker PK"
NEXT_PUBLIC_PRO_PRICE_PKR="1500"
NEXT_PUBLIC_PRO_PERIOD="month"
NEXT_PUBLIC_PAY_JAZZCASH="0300-0000000 (Account Title: Your Name)"
NEXT_PUBLIC_PAY_EASYPAISA="0345-0000000 (Account Title: Your Name)"
NEXT_PUBLIC_PAY_BANK="Meezan Bank — IBAN PK00MEZN0000000000000000 — Title: Your Business"
NEXT_PUBLIC_SUPPORT_WHATSAPP="923000000000"

# Free trial paper limit per new institution
FREE_TRIAL_PAPER_LIMIT="20"
FREE_TRIAL_DAYS="30"

# --- Forgot-password emails (optional, free) ---
# Gmail: turn on 2-step verification → Google Account → Security → App passwords → create one.
# If left empty, the Super Admin creates reset links in /admin → Users and sends them on WhatsApp.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PaperMaker PK <your@gmail.com>"
